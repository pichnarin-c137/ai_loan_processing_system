# Copy to .env. Local defaults are already set in infra/compose.yml;
# only put real secrets in .env (never commit it).
# Never put MIGRATION_DATABASE_URL here: the API and worker read this file, and that URL is the
# database owner's. Only the migration step gets it.

# Shown in the UI title, messages and on synthetic documents.
APP_NAME=Loan Desk
VITE_APP_NAME=Loan Desk

# Production only: the auth service's signing secret, a random value of at least 32 characters
# (openssl rand -base64 32). Set it on the auth service only; it refuses to start in production
# without one. Locally it falls back to a development value.
# BETTER_AUTH_SECRET=

# Only if a proxy in front of the auth service adds to X-Forwarded-For instead of replacing it:
# that proxy's IPs or CIDR ranges, comma-separated, so rate limits see the real client IP.
# AUTH_TRUSTED_PROXIES=

# Production only (Step 2): Cloudflare R2 instead of the local SeaweedFS.
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
