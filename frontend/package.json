{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations --silent",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "vitest run",
		"e2e": "playwright test",
		"gen:api": "openapi-typescript src/lib/api/openapi.json -o src/lib/api/schema.d.ts"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.18.2",
		"@lucide/svelte": "^1.64.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/svelte-query": "^6.3.6",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"auth": "workspace:*",
		"better-auth": "^1.7.14",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"openapi-fetch": "^0.17.0",
		"openapi-typescript": "^7.13.0",
		"playwright": "^1.60.0",
		"shadcn-svelte": "1.7.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
